[Unit]
Description=router7 DHCPv4 server (host-OS port) on %i
After=network.target
# %i = the LAN interface (e.g. eth1). State + leases under /var/lib/router7.
[Service]
Type=simple
ExecStart=/usr/local/bin/router7-dhcp4d --interface %i --perm /var/lib/router7
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target

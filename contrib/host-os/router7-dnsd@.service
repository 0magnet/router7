[Unit]
Description=router7 DNS server (host-OS port) on %i
After=network.target router7-dhcp4d@%i.service
[Service]
Type=simple
ExecStart=/usr/local/bin/router7-dnsd --lan %i --perm /var/lib/router7
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
